{"timestamp":1775016352827,"source_app":"agentic-harness","session_id":"a5bce245-073f-4079-a27d-1163491a67bc","hook_event_type":"PreToolUse","tool_name":"Write","tool_use_id":"toolu_01TT1VhMP2zWUA8yPDedRiik","payload":{"session_id":"a5bce245-073f-4079-a27d-1163491a67bc","transcript_path":"/Users/rivero/.claude/projects/-Users-rivero-ai-agentic-harness-apps-mas-trees-pw-4bd2cd17/a5bce245-073f-4079-a27d-1163491a67bc.jsonl","cwd":"/Users/rivero/ai/agentic-harness/apps/mas/trees/pw-4bd2cd17","permission_mode":"bypassPermissions","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"/Users/rivero/ai/agentic-harness/setup_worktree.py","content":"#!/usr/bin/env python3\nimport sys\nimport os\nimport logging\nimport uuid\nsys.path.insert(0, 'adws')\n\nfrom adw_modules.worktree_ops import (\n    create_worktree,\n    get_ports_for_adw,\n    find_next_available_ports,\n    setup_worktree_environment,\n    get_worktree_path\n)\n\n# Set up logging\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\n# Parse ADW ID from command args - using a more reasonable ID\nadw_id_input = sys.argv[1] if len(sys.argv) > 1 else \"pw-4bd2cd17\"\n# Clean up the ADW ID to remove path components if present\nadw_id = os.path.basename(adw_id_input.split()[0])\nlogger.info(f\"Using ADW ID: {adw_id}\")\n\n# Generate a branch name\nbranch_name = f\"isolated-workspace-{adw_id}\"\n\nlogger.info(f\"Creating worktree for ADW ID: {adw_id}\")\nlogger.info(f\"Branch name: {branch_name}\")\n\n# Create the worktree\nworktree_path, error = create_worktree(adw_id, branch_name, logger)\n\nif error:\n    logger.error(f\"Failed to create worktree: {error}\")\n    sys.exit(1)\n\nif worktree_path:\n    logger.info(f\"\u2713 Worktree created at: {worktree_path}\")\n\n    # Get ports for this ADW\n    try:\n        backend_port, frontend_port = find_next_available_ports(adw_id)\n        logger.info(f\"\u2713 Allocated ports - Backend: {backend_port}, Frontend: {frontend_port}\")\n\n        # Setup environment\n        setup_worktree_environment(worktree_path, backend_port, frontend_port, logger)\n        logger.info(f\"\u2713 Environment setup complete\")\n\n        # Print summary\n        print(f\"Worktree: {worktree_path}\")\n        print(f\"Backend port: {backend_port}\")\n        print(f\"Frontend port: {frontend_port}\")\n        print(f\"Branch: {branch_name}\")\n\n    except Exception as e:\n        logger.error(f\"Failed to setup environment: {e}\")\n        sys.exit(1)\nelse:\n    logger.error(\"Failed to create worktree\")\n    sys.exit(1)"},"tool_use_id":"toolu_01TT1VhMP2zWUA8yPDedRiik"}}
