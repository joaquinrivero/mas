{"timestamp":1774905396239,"source_app":"agentic-harness","session_id":"998009a5-a8c0-4c7b-90de-06393c4a3a60","hook_event_type":"PreToolUse","tool_name":"Write","tool_use_id":"toolu_012Heuao2srNNoocaBEeatGW","payload":{"session_id":"998009a5-a8c0-4c7b-90de-06393c4a3a60","transcript_path":"/Users/rivero/.claude/projects/-Users-rivero-ai-agentic-experience-apps-mas-trees-9ee16026/998009a5-a8c0-4c7b-90de-06393c4a3a60.jsonl","cwd":"/Users/rivero/ai/agentic-experience/apps/mas/trees/9ee16026","permission_mode":"bypassPermissions","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"/Users/rivero/ai/agentic-experience/apps/mas/trees/9ee16026/studio/src/utils/fragment-utils.js","content":"/**\n * Returns a title unique among existingTitles.\n * If baseTitle already exists, appends -1, -2, \u2026 until unique.\n * If baseTitle ends with -N, strips the suffix before incrementing\n * so that successive clones produce -1, -2, -3 (not -1-1, -1-2).\n *\n * @param {string} baseTitle\n * @param {string[]} existingTitles\n * @returns {string}\n */\nexport function generateUniqueFragmentTitle(baseTitle, existingTitles) {\n    const titleSet = new Set(existingTitles);\n    if (!titleSet.has(baseTitle)) return baseTitle;\n\n    const match = baseTitle.match(/^(.*)-(\\d+)$/);\n    const stem = match ? match[1] : baseTitle;\n    let counter = 1;\n    while (titleSet.has(`${stem}-${counter}`)) counter++;\n    return `${stem}-${counter}`;\n}\n"},"tool_use_id":"toolu_012Heuao2srNNoocaBEeatGW"}}
{"timestamp":1774905400203,"source_app":"agentic-harness","session_id":"998009a5-a8c0-4c7b-90de-06393c4a3a60","hook_event_type":"PreToolUse","tool_name":"Write","tool_use_id":"toolu_015Bm5pgoaB5kzdDFHmtFHie","payload":{"session_id":"998009a5-a8c0-4c7b-90de-06393c4a3a60","transcript_path":"/Users/rivero/.claude/projects/-Users-rivero-ai-agentic-experience-apps-mas-trees-9ee16026/998009a5-a8c0-4c7b-90de-06393c4a3a60.jsonl","cwd":"/Users/rivero/ai/agentic-experience/apps/mas/trees/9ee16026","permission_mode":"bypassPermissions","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"/Users/rivero/ai/agentic-experience/apps/mas/trees/9ee16026/studio/test/fragment-utils.test.js","content":"import { expect } from '@esm-bundle/chai';\nimport { generateUniqueFragmentTitle } from '../src/utils/fragment-utils.js';\n\ndescribe('generateUniqueFragmentTitle', () => {\n    it('returns baseTitle unchanged when no conflict', () => {\n        expect(generateUniqueFragmentTitle('card-a', ['card-b'])).to.equal('card-a');\n    });\n    it('appends -1 for first conflict', () => {\n        expect(generateUniqueFragmentTitle('lucy-card', ['lucy-card'])).to.equal('lucy-card-1');\n    });\n    it('increments suffix past existing clones', () => {\n        expect(generateUniqueFragmentTitle('lucy-card', ['lucy-card', 'lucy-card-1'])).to.equal('lucy-card-2');\n    });\n    it('strips existing -N suffix before incrementing', () => {\n        expect(generateUniqueFragmentTitle('lucy-card-1', ['lucy-card-1'])).to.equal('lucy-card-2');\n    });\n    it('handles empty existingTitles', () => {\n        expect(generateUniqueFragmentTitle('card', [])).to.equal('card');\n    });\n    it('skips gaps (e.g. -1 taken, -2 free)', () => {\n        expect(generateUniqueFragmentTitle('card', ['card', 'card-1', 'card-2'])).to.equal('card-3');\n    });\n});\n"},"tool_use_id":"toolu_015Bm5pgoaB5kzdDFHmtFHie"}}
