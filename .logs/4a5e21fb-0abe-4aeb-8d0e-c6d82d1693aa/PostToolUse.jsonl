    >\n                            <sp-sidenav-item\n                                value=\"pdf\"\n                                label=\"PDF\"\n                            ></sp-sidenav-item>\n                            <sp-sidenav-item\n                                value=\"esignature\"\n                                label=\"E-Signatures\"\n                            ></sp-sidenav-item>\n                        </sp-sidenav-item>\n                    </sp-sidenav>\n                </merch-sidenav-list>\n                <merch-sidenav-checkbox-group\n                    sidenavCheckboxTitle=\"Types\"\n                    label=\"types\"\n                    deeplink=\"types\"\n                >\n                    <sp-checkbox emphasized name=\"desktop\">Desktop</sp-checkbox>\n                    <sp-checkbox emphasized name=\"mobile\">Mobile</sp-checkbox>\n                    <sp-checkbox emphasized name=\"web\">Web</sp-checkbox>\n                </merch-sidenav-checkbox-group>\n                <merch-sidenav-list sidenavListTitle=\"RESOURCES\">\n                    <sp-sidenav manageTabIndex=\"true\" label=\"resources\">\n                        <sp-sidenav-item\n                            href=\"/products/special-offers.html\"\n                            target=\"_blank\"\n                            aria-label=\"Open the Special Offers page in a new tab\">\n                            Special Offers<sp-icon-link-out-light\n                                class=\"right\"\n                                slot=\"icon\"\n                            >\n                            </sp-icon-link-out-light>\n                        </sp-sidenav-item>\n                    </sp-sidenav>\n                </merch-sidenav-list>\n            </merch-sidenav>\n        </template>\n    </body>\n</html>\n","numLines":112,"startLine":1,"totalLines":112}},"tool_use_id":"toolu_018cBYcR9sVHbydPfrAV6UQA"}}
