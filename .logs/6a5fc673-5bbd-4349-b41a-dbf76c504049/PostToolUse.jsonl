\"merch-sidenav\"></div>\n        </main>\n        <template id=\"merch-sidenav-template\">\n            <merch-sidenav sidenavTitle=\"REFINE YOUR RESULTS\">\n                <merch-search deeplink=\"search\">\n                    <sp-search placeholder=\"Search all products\"></sp-search>\n                </merch-search>\n                <merch-sidenav-list deeplink=\"filter\">\n                    <sp-sidenav\n                        variant=\"multilevel\"\n                        manageTabIndex=\"true\"\n                        label=\"category\"\n                    >\n                        <sp-sidenav-item\n                            value=\"all\"\n                            label=\"All\"\n                            selected\n                        ></sp-sidenav-item>\n                        <sp-sidenav-item\n                            label=\"Creativity And Design\"\n                            value=\"creativitydesign\"\n                        >\n                            <sp-sidenav-item\n                                value=\"photo\"\n                                label=\"Photo\"\n                            ></sp-sidenav-item>\n                            <sp-sidenav-item\n                                value=\"graphic-design\"\n                                label=\"Graphic Design\"\n                            ></sp-sidenav-item>\n                            <sp-sidenav-item\n                                value=\"video\"\n                                label=\"Video\"\n                            ></sp-sidenav-item>\n                            <sp-sidenav-item\n                                value=\"illustration\"\n                                label=\"Illustration\"\n                            ></sp-sidenav-item>\n                        </sp-sidenav-item>\n                        <sp-sidenav-item\n                            label=\"PDF and E-signatures\"\n                            value=\"pdfesignature\"\n                        >\n                            <sp-sidenav-item\n                                value=\"pdf\"\n                                label=\"PDF\"\n                            ></sp-sidenav-item>\n                            <sp-sidenav-item\n                                value=\"esignature\"\n                                label=\"E-Signatures\"\n                            ></sp-sidenav-item>\n                        </sp-sidenav-item>\n                    </sp-sidenav>\n                </merch-sidenav-list>\n                <merch-sidenav-checkbox-group\n                    sidenavCheckboxTitle=\"Types\"\n                    label=\"types\"\n                    deeplink=\"types\"\n                >\n                    <sp-checkbox emphasized name=\"desktop\">Desktop</sp-checkbox>\n                    <sp-checkbox emphasized name=\"mobile\">Mobile</sp-checkbox>\n                    <sp-checkbox emphasized name=\"web\">Web</sp-checkbox>\n                </merch-sidenav-checkbox-group>\n                <merch-sidenav-list sidenavListTitle=\"RESOURCES\">\n                    <sp-sidenav manageTabIndex=\"true\" label=\"resources\">\n                        <sp-sidenav-item\n                            href=\"/products/special-offers.html\"\n                            target=\"_blank\"\n                            aria-label=\"Open the Special Offers page in a new tab\">\n                            Special Offers<sp-icon-link-out-light\n                                class=\"right\"\n                                slot=\"icon\"\n                            >\n                            </sp-icon-link-out-light>\n                        </sp-sidenav-item>\n                    </sp-sidenav>\n                </merch-sidenav-list>\n            </merch-sidenav>\n        </template>\n    </body>\n</html>\n","numLines":112,"startLine":1,"totalLines":112}},"tool_use_id":"toolu_01XPyBfCKqQThr5JrfKnvV9n"}}
